# Shared public spawn. Team city progression is separate from this hub.
# /spawn is provided by EssentialsSpawn; /hub and /lobby use the same spawn.
options:
    hub-prefix: &3[Lost Sky]&r

function skyHubMenu(p: player):
    set {_inv} to chest inventory with 4 rows named "&3Lost Sky | Sky Harbor"
    set slot 10 of {_inv} to grass block named "&aYour Island" with lore "&7Create an island or return to your team" and "&eClick to use /is"
    set slot 11 of {_inv} to stone bricks named "&dTeam City" with lore "&7Your team restoration area" and "&eClick to open /is city"
    set slot 12 of {_inv} to book named "&bGetting Started" with lore "&7Build an island, invite friends, restore your city" and "&eClick for a quick guide"
    set slot 14 of {_inv} to compass named "&6Return to Spawn" with lore "&7Meet other players at Sky Harbor" and "&eClick to return to spawn"
    set slot 19 of {_inv} to wheat named "&aFarm Market" with lore "&7Sell crops for in-game money"
    set slot 21 of {_inv} to chest named "&bSupply Shop" with lore "&7Buy materials with in-game money" and "&eEarn money from crops and quests"
    set slot 23 of {_inv} to enchanted book named "&dHarbor Quests" with lore "&7Deliver items for money and Relics"
    set slot 25 of {_inv} to gold ingot named "&6Supporter Shop" with lore "&7Official information"
    set slot 31 of {_inv} to barrier named "&cClose Menu"
    set {lostskyhub::menu::%uuid of {_p}%} to {_inv}
    open {_inv} to {_p}

function skyHubGuide(p: player):
    send "{@hub-prefix} &bWelcome to Sky Harbor!" to {_p}
    send "&f1. &a/is &7Create an island or return to your team" to {_p}
    send "&f2. &a/is team invite <player> &7Invite a friend to your team" to {_p}
    send "&f3. &a/market &7Sell crops or &a/skyquests &7Deliver items to earn money" to {_p}
    send "&f4. &b/skyshop &7Buy materials with in-game money | &b/bal &7Check your balance" to {_p}
    send "&f5. &d/is city &7Open the team city menu" to {_p}
    send "&e/spawn &7Return to Sky Harbor   &e/menu &7Open menu" to {_p}

command /hub:
    aliases: /lobby
    executable by: players
    trigger:
        execute player command "essentials:spawn"

command /menu:
    aliases: /skymenu
    executable by: players
    trigger:
        skyHubMenu(player)

command /skyguide:
    executable by: players
    trigger:
        skyHubGuide(player)

on right click on entity:
    if name of player's world is not "lobby":
        stop
    if uncolored name of clicked entity is "Lost Sky Guide":
        cancel event
        skyHubMenu(player)
    else if uncolored name of clicked entity is "Island Captain":
        cancel event
        skyHubMenu(player)
    else if uncolored name of clicked entity is "City Architect":
        cancel event
        execute player command "city"

on inventory click:
    if {lostskyhub::menu::%uuid of player%} is not set:
        stop
    if player's current inventory is not {lostskyhub::menu::%uuid of player%}:
        stop
    cancel event
    if clicked inventory is not {lostskyhub::menu::%uuid of player%}:
        stop
    set {_choice} to index of event-slot
    close player's inventory
    if {_choice} is 10:
        execute player command "is"
    else if {_choice} is 11:
        execute player command "city"
    else if {_choice} is 12:
        skyHubGuide(player)
    else if {_choice} is 14:
        execute player command "essentials:spawn"
    else if {_choice} is 19:
        execute player command "market"
    else if {_choice} is 21:
        execute player command "skyshop"
    else if {_choice} is 23:
        execute player command "skyquests"
    else if {_choice} is 25:
        execute player command "topup"

on inventory drag:
    if {lostskyhub::menu::%uuid of player%} is set:
        if player's current inventory is {lostskyhub::menu::%uuid of player%}:
            cancel event

on inventory close:
    if event-inventory is {lostskyhub::menu::%uuid of player%}:
        delete {lostskyhub::menu::%uuid of player%}

on quit:
    delete {lostskyhub::menu::%uuid of player%}

on load:
    delete {lostskyhub::menu::*}

# Prevent falling off the shared floating island from killing visitors.
every 10 ticks:
    loop all players:
        if name of loop-player's world is "lobby":
            if y-coordinate of loop-player is below 45:
                teleport loop-player to location(0.5, 100, 0.5, world "lobby", 180, 0)
                set fall distance of loop-player to 0

on join:
    wait 1 second
    if player is online:
        teleport player to location(0.5, 100, 0.5, world "lobby", 180, 0)
        set fall distance of player to 0
        send "{@hub-prefix} &b/menu &7Open harbor menu | &b/spawn &7Return to spawn" to player

on respawn:
    if name of player's world is "lobby":
        set respawn location to location(0.5, 100, 0.5, world "lobby", 180, 0)
