# Team cities keyed by BentoBox island ID, not player name or team owner.
# Requires skript-reflect 2.6.3, BentoBox and WorldEdit.
# The island comes from lostsky-islands.sk (validated active island), so a
# player in several island teams reaches the city of the island they chose.
import:
    world.bentobox.bentobox.BentoBox
    org.bukkit.Bukkit
    java.io.File
    java.io.FileInputStream
    com.sk89q.worldedit.WorldEdit
    com.sk89q.worldedit.bukkit.BukkitAdapter
    com.sk89q.worldedit.extent.clipboard.io.BuiltInClipboardFormat
    com.sk89q.worldedit.session.ClipboardHolder
    com.sk89q.worldedit.math.BlockVector3
    com.sk89q.worldedit.function.operation.Operations
    com.sk89q.worldedit.util.SideEffectSet

# Active island ID (re-validated: exists, BSkyBlock world, player in team).
# Before multi-island support this used IslandsManager.getIsland(world, uuid),
# which returns the island the player is standing on first; for players with a
# single island both give the same ID, so existing city data still matches.
function skyCityKey(p: player) :: text:
    return skyIslandSelected({_p})

# Optional slot argument from /city <slot>, /city go <slot>, /is city [go] <slot>.
# Resolves the display position to an island ID now; only the ID is stored.
function skyCityPick(p: player, slot: text) :: boolean:
    set {_n} to {_slot} parsed as integer
    if {_n} is not set:
        send "&3[Lost Sky] &eUse a slot number, e.g. /city go 2" to {_p}
        return false
    set {_id} to skyIslandAtSlot({_p}, {_n})
    if {_id} is "":
        send "&3[Lost Sky] &eYou have no island in slot %{_n}%. Use /islands to see them." to {_p}
        return false
    return skyIslandSelect({_p}, {_id})

function skyCityBuild(slot: number, chapter: number) :: boolean:
    set {_world} to Bukkit.getWorld("lostsky_cities")
    if {_chapter} is 0:
        set {_world} to Bukkit.getWorld("lobby")
    if {_world} is not set:
        return false
    set {_file} to new File("plugins/WorldEdit/schematics/lobby_ch%{_chapter}%.schem")
    if {_chapter} is 0:
        set {_file} to new File("plugins/WorldEdit/schematics/spawn_hub.schem")
    if {_file}.exists() is false:
        return false
    set {_stream} to new FileInputStream({_file})
    set {_format} to BuiltInClipboardFormat.SPONGE_V2_SCHEMATIC
    set {_reader} to {_format}.getReader({_stream})
    set {_clipboard} to try {_reader}.read()
    {_reader}.close()
    if {_clipboard} is not set:
        return false
    set {_adapted} to BukkitAdapter.adapt({_world})
    set {_session} to WorldEdit.getInstance().newEditSession({_adapted})
    # Protected prefabs do not need post-edit physics simulation. Disabling
    # buffering avoids retaining every air cell for simulation on close.
    {_session}.setSideEffectApplier(SideEffectSet.none())
    {_session}.disableBuffering()
    set {_holder} to new ClipboardHolder({_clipboard})
    set {_x} to {_slot} * 512
    set {_target} to BlockVector3.at({_x}, 100, 0)
    set {_paste} to {_holder}.createPaste({_session})
    {_paste}.to({_target})
    {_paste}.ignoreAirBlocks(false)
    {_paste}.copyEntities(false)
    set {_operation} to {_paste}.build()
    try Operations.complete({_operation})
    set {_pasteError} to last java error
    {_session}.close()
    if {_pasteError} is set:
        send "[Lost Sky] City paste failed: %{_pasteError}%" to console
        return false
    set {_floor} to {_world}.getBlockAt({_x}, 99, 0)
    if "%{_floor}.getType()%" is "CHISELED_QUARTZ_BLOCK":
        return true
    return false

command /lshubbuild:
    executable by: console
    trigger:
        if {skycity::building} is true:
            send "[Lost Sky] Another paste is running."
            stop
        loop all players:
            if name of loop-player's world is "lobby":
                send "&eUpdating Sky Harbor. Please wait." to loop-player
                teleport loop-player to location(0.5, 140, 0.5, world "lobby")
        set {skycity::building} to true
        set {_ok} to skyCityBuild(0, 0)
        delete {skycity::building}
        loop all players:
            if name of loop-player's world is "lobby":
                teleport loop-player to location(0.5, 100, 0.5, world "lobby", 180, 0)
                set fall distance of loop-player to 0
        send "[Lost Sky] Spawn paste result: %{_ok}%"

function skyCityGo(p: player):
    set {_key} to skyCityKey({_p})
    if {_key} is "":
        send "&3[Lost Sky] &eCreate or join an island with /is first" to {_p}
        stop
    if {skycity::ready::%{_key}%} is not true:
        if {skycity::building} is true:
            send "&3[Lost Sky] &eCity preparation is in progress. Try again shortly." to {_p}
            stop
        if {skycity::slot::%{_key}%} is not set:
            add 1 to {skycity::next}
            set {skycity::slot::%{_key}%} to {skycity::next}
        set {skycity::building} to true
        send "&3[Lost Sky] &ePreparing your team city ruins..." to {_p}
        set {_ok} to skyCityBuild({skycity::slot::%{_key}%}, 1)
        delete {skycity::building}
        if {_ok} is not true:
            send "&3[Lost Sky] &cCould not prepare your city. Please contact staff." to {_p}
            stop
        set {skycity::chapter::%{_key}%} to 1
        set {skycity::points::%{_key}%} to 0
        set {skycity::ready::%{_key}%} to true
    set {_x} to {skycity::slot::%{_key}%} * 512 + 0.5
    teleport {_p} to location({_x}, 100, 0.5, world "lostsky_cities", 180, 0)
    set fall distance of {_p} to 0
    send "&3[Lost Sky] &aTeam City - Chapter %{skycity::chapter::%{_key}%}% &7| /city Open restoration menu" to {_p}

function skyCityMenu(p: player):
    set {_key} to skyCityKey({_p})
    if {_key} is "":
        send "&3[Lost Sky] &eCreate or join an island with /is first" to {_p}
        stop
    set {_chapter} to {skycity::chapter::%{_key}%} ? 1
    set {_points} to {skycity::points::%{_key}%} ? 0
    set {_inv} to chest inventory with 3 rows named "&5Lost Sky | Team City"
    set slot 22 of {_inv} to grass block named "&aChoose Island" with lore "&7This menu is for your active island" and "&7Each island has its own city" and "&eClick to switch"
    set slot 10 of {_inv} to ender pearl named "&aVisit Team City" with lore "&7Travel to your team restoration area"
    set slot 12 of {_inv} to book named "&eChapter %{_chapter}% | Relic %{_points}%" with lore "&7Milestones: 100 / 300 / 600 / 1000" and "&7Progress is shared only with your team"
    set slot 14 of {_inv} to amethyst shard named "&dDonate Relics" with lore "&7Hold a Relic in your main hand and click" and "&7Reach a milestone to unlock the next chapter"
    set slot 16 of {_inv} to compass named "&bReturn to Spawn"
    set slot 20 of {_inv} to oak sapling named "&aRestoration Projects" with lore "&7Restore a small garden with building materials" and "&eClick to view your team's project"
    set {skycity::menu::%uuid of {_p}%} to {_inv}
    open {_inv} to {_p}

function skyCityDonate(p: player):
    set {_key} to skyCityKey({_p})
    if {_key} is "":
        stop
    if {skycity::ready::%{_key}%} is not true:
        send "&3[Lost Sky] &eVisit your city with /city go first" to {_p}
        stop
    set {_chapter} to {skycity::chapter::%{_key}%}
    if {_chapter} >= 5:
        send "&3[Lost Sky] &aYour team city is fully restored!" to {_p}
        stop
    set {_value} to relicValue({_p}'s tool)
    if {_value} <= 0:
        send "&3[Lost Sky] &eHold a Lost Sky Relic in your main hand" to {_p}
        stop
    if {skycity::building} is true:
        send "&3[Lost Sky] &eRestoration is in progress. Try again shortly." to {_p}
        stop
    set {_newpoints} to {skycity::points::%{_key}%} + {_value}
    set {_next} to {_chapter} + 1
    set {_goal} to {lostsky::goal::%{_next}%}
    if {_newpoints} >= {_goal}:
        set {skycity::building} to true
        # Move visitors clear before replacing the prefab. Their island stays intact.
        set {_cx} to {skycity::slot::%{_key}%} * 512
        loop all players:
            if name of loop-player's world is "lostsky_cities":
                set {_dx} to x-coordinate of loop-player - {_cx}
                if {_dx} is between -65 and 65:
                    teleport loop-player to location(0.5, 100, 0.5, world "lobby", 180, 0)
        set {_ok} to skyCityBuild({skycity::slot::%{_key}%}, {_next})
        delete {skycity::building}
        if {_ok} is not true:
            send "&3[Lost Sky] &cRestoration failed. Your Relics were not consumed." to {_p}
            stop
        set {skycity::chapter::%{_key}%} to {_next}
        send "&3[Lost Sky] &6Your team city reached chapter %{_next}%!" to {_p}
    remove 1 of {_p}'s tool from {_p}'s inventory
    set {skycity::points::%{_key}%} to {_newpoints}
    send "&3[Lost Sky] &aDonation accepted +%{_value}% | Total %{_newpoints}%" to {_p}

# /city            menu for the active island
# /city <slot>     choose island in that slot, then menu
# /city go [slot]  warp to the (chosen) island's city
# /city donate     donate to the active island's city
function skyCityCommand(p: player, a: text, b: text):
    if {_a} is "go":
        if {_b} is not "":
            if skyCityPick({_p}, {_b}) is false:
                stop
        skyCityGo({_p})
    else if {_a} is "donate":
        skyCityDonate({_p})
    else if {_a} is "":
        skyCityMenu({_p})
    else:
        if skyCityPick({_p}, {_a}) is false:
            stop
        skyCityMenu({_p})

command /city [<text>] [<text>]:
    executable by: players
    trigger:
        skyCityCommand(player, arg-1 ? "", arg-2 ? "")

# Exact aliases without replacing BentoBox's /is command or its other subcommands:
# /is city, /is city <slot>, /is city go, /is city go <slot> (and /island ...).
on command:
    set {_parts::*} to (full command) split at " "
    if {_parts::1} is not "is" or "island":
        stop
    if {_parts::2} is not "city":
        stop
    if size of {_parts::*} > 4:
        stop
    cancel event
    skyCityCommand(player, {_parts::3} ? "", {_parts::4} ? "")

on inventory click:
    if {skycity::menu::%uuid of player%} is not set:
        stop
    if player's current inventory is not {skycity::menu::%uuid of player%}:
        stop
    cancel event
    if clicked inventory is not {skycity::menu::%uuid of player%}:
        stop
    set {_choice} to index of event-slot
    close player's inventory
    if {_choice} is 10:
        skyCityGo(player)
    else if {_choice} is 14:
        skyCityDonate(player)
    else if {_choice} is 16:
        execute player command "essentials:spawn"
    else if {_choice} is 20:
        skyProjectMenu(player)
    else if {_choice} is 22:
        skyIslandMenu(player)

on inventory drag:
    if {skycity::menu::%uuid of player%} is set:
        if player's current inventory is {skycity::menu::%uuid of player%}:
            cancel event

on inventory close:
    if event-inventory is {skycity::menu::%uuid of player%}:
        delete {skycity::menu::%uuid of player%}

on quit:
    delete {skycity::menu::%uuid of player%}

on load:
    delete {skycity::menu::*}
    delete {skycity::building}

every 10 ticks:
    loop all players:
        if name of loop-player's world is "lostsky_cities":
            if y-coordinate of loop-player is below 45:
                teleport loop-player to location(0.5, 100, 0.5, world "lobby", 180, 0)
                set fall distance of loop-player to 0
