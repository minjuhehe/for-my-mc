# Public town economy: in-game money only. No real payment integration.
options:
    market-prefix: &3[Lost Sky]&r
    topup-url: unset

function skyTownMenu(p: player, kind: text):
    set {_inv} to chest inventory with 3 rows named "&3Lost Sky | %{_kind}%"
    if {_kind} is "farm":
        set slot 10 of {_inv} to wheat named "&aSell 32 Wheat" with lore "&7Receive $32"
        set slot 11 of {_inv} to carrot named "&aSell 32 Carrots" with lore "&7Receive $24"
        set slot 12 of {_inv} to potato named "&aSell 32 Potatoes" with lore "&7Receive $24"
        set slot 13 of {_inv} to beetroot named "&aSell 32 Beetroot" with lore "&7Receive $32"
        set slot 14 of {_inv} to pumpkin named "&aSell 8 Pumpkins" with lore "&7Receive $40"
        set slot 15 of {_inv} to melon slice named "&aSell 32 Melon Slices" with lore "&7Receive $16"
    else if {_kind} is "shop":
        set slot 10 of {_inv} to cobblestone named "&bBuy 32 Cobblestone" with lore "&7Price $32"
        set slot 11 of {_inv} to dirt named "&bBuy 32 Dirt" with lore "&7Price $64"
        set slot 12 of {_inv} to oak log named "&bBuy 16 Oak Logs" with lore "&7Price $96"
        set slot 13 of {_inv} to glass named "&bBuy 16 Glass" with lore "&7Price $64"
        set slot 14 of {_inv} to wheat seeds named "&bBuy 16 Wheat Seeds" with lore "&7Price $16"
        set slot 15 of {_inv} to torch named "&bBuy 16 Torches" with lore "&7Price $24"
    else if {_kind} is "quests":
        set slot 11 of {_inv} to wheat named "&eHarbor Supplies" with lore "&7Deliver 64 Wheat" and "&aReward: $100 + 2 Common Shards" and "&7Available every 24 hours"
        set slot 15 of {_inv} to cobblestone named "&eApprentice Builder" with lore "&7Deliver 128 Cobblestone" and "&aReward: $80 + 2 Common Shards" and "&7Available every 24 hours"
    else if {_kind} is "topup":
        set slot 13 of {_inv} to gold ingot named "&6Supporter Shop" with lore "&7Click for official information" and "&7In-game money is separate from real money"
    set slot 22 of {_inv} to barrier named "&cClose Menu"
    set {skytown::menu::%uuid of {_p}%} to {_inv}
    set {skytown::kind::%uuid of {_p}%} to {_kind}
    open {_inv} to {_p}

function skyTownTrade(p: player, goods: itemtype, count: number, price: number, buy: boolean):
    set {_stack} to {_goods}
    set amount of {_stack} to {_count}
    if {_buy} is true:
        if {_p}'s balance < {_price}:
            send "{@market-prefix} &cNot enough money. Required: $%{_price}%" to {_p}
            stop
        if {_p}'s inventory cannot hold {_stack}:
            send "{@market-prefix} &cInventory full. Make room before buying." to {_p}
            stop
        remove {_price} from {_p}'s balance
        give {_stack} to {_p}
        send "{@market-prefix} &bPurchase complete &7(-$%{_price}%)" to {_p}
    else:
        if {_p}'s inventory does not contain {_stack}:
            send "{@market-prefix} &cNot enough items. Required: %{_count}%" to {_p}
            stop
        remove {_stack} from {_p}'s inventory
        add {_price} to {_p}'s balance
        send "{@market-prefix} &aSale complete &7(+$%{_price}%)" to {_p}

function skyTownQuest(p: player, key: text, goods: itemtype, count: number, reward: number):
    if {skytown::quest::%uuid of {_p}%::%{_key}%} is set:
        set {_elapsed} to difference between now and {skytown::quest::%uuid of {_p}%::%{_key}%}
        if {_elapsed} < 24 hours:
            send "{@market-prefix} &eQuest already completed. Return after 24 hours." to {_p}
            stop
    set {_stack} to {_goods}
    set amount of {_stack} to {_count}
    if {_p}'s inventory does not contain {_stack}:
        send "{@market-prefix} &eRequired items: %{_count}%" to {_p}
        stop
    set {_relic} to relicItem("shard")
    set amount of {_relic} to 2
    if {_p}'s inventory cannot hold {_relic}:
        send "{@market-prefix} &cMake room for your Relic reward first" to {_p}
        stop
    set {skytown::quest::%uuid of {_p}%::%{_key}%} to now
    remove {_stack} from {_p}'s inventory
    add {_reward} to {_p}'s balance
    give {_relic} to {_p}
    send "{@market-prefix} &aQuest complete &7+$%{_reward}% and 2 Common Shards" to {_p}

function skyTownTopup(p: player):
    set {_url} to "{@topup-url}"
    if {_url} is "unset":
        send "{@market-prefix} &ePayments are closed. Official details will be announced later." to {_p}
    else:
        send formatted "&6Official supporter page: <link:{@topup-url}>&b[Open website]<reset>" to {_p}

command /market:
    executable by: players
    trigger:
        execute player command "lostskyworth:lssell"

command /skyshop:
    executable by: players
    trigger:
        execute player command "economyshopgui:shop"

command /skyquests:
    executable by: players
    trigger:
        skyTownMenu(player, "quests")

command /topup:
    executable by: players
    trigger:
        skyTownMenu(player, "topup")

on right click on entity:
    if name of player's world is not "lobby":
        stop
    if uncolored name of clicked entity is "Farm Merchant":
        cancel event
        execute player command "lostskyworth:lssell"
    else if uncolored name of clicked entity is "Supply Merchant":
        cancel event
        execute player command "economyshopgui:shop"
    else if uncolored name of clicked entity is "Quest Keeper":
        cancel event
        skyTownMenu(player, "quests")
    else if uncolored name of clicked entity is "Sky Concierge":
        cancel event
        skyTownMenu(player, "topup")

on inventory click:
    if {skytown::menu::%uuid of player%} is not set:
        stop
    if player's current inventory is not {skytown::menu::%uuid of player%}:
        stop
    cancel event
    if clicked inventory is not {skytown::menu::%uuid of player%}:
        stop
    set {_slot} to index of event-slot
    set {_kind} to {skytown::kind::%uuid of player%}
    close player's inventory
    if {_kind} is "farm":
        if {_slot} is 10:
            skyTownTrade(player, wheat, 32, 32, false)
        else if {_slot} is 11:
            skyTownTrade(player, carrot, 32, 24, false)
        else if {_slot} is 12:
            skyTownTrade(player, potato, 32, 24, false)
        else if {_slot} is 13:
            skyTownTrade(player, beetroot, 32, 32, false)
        else if {_slot} is 14:
            skyTownTrade(player, pumpkin, 8, 40, false)
        else if {_slot} is 15:
            skyTownTrade(player, melon slice, 32, 16, false)
    else if {_kind} is "shop":
        if {_slot} is 10:
            skyTownTrade(player, cobblestone, 32, 32, true)
        else if {_slot} is 11:
            skyTownTrade(player, dirt, 32, 64, true)
        else if {_slot} is 12:
            skyTownTrade(player, oak log, 16, 96, true)
        else if {_slot} is 13:
            skyTownTrade(player, glass, 16, 64, true)
        else if {_slot} is 14:
            skyTownTrade(player, wheat seeds, 16, 16, true)
        else if {_slot} is 15:
            skyTownTrade(player, torch, 16, 24, true)
    else if {_kind} is "quests":
        if {_slot} is 11:
            skyTownQuest(player, "farmer", wheat, 64, 100)
        else if {_slot} is 15:
            skyTownQuest(player, "builder", cobblestone, 128, 80)
    else if {_kind} is "topup":
        if {_slot} is 13:
            skyTownTopup(player)

on inventory drag:
    if {skytown::menu::%uuid of player%} is set:
        if player's current inventory is {skytown::menu::%uuid of player%}:
            cancel event

on inventory close:
    if event-inventory is {skytown::menu::%uuid of player%}:
        delete {skytown::menu::%uuid of player%}
        delete {skytown::kind::%uuid of player%}

on quit:
    delete {skytown::menu::%uuid of player%}
    delete {skytown::kind::%uuid of player%}

on load:
    delete {skytown::menu::*}
    delete {skytown::kind::*}

# Route /sell to the deposit GUI, avoiding Essentials instant hand sales.
on command:
    if command is "sell" or "sellgui":
        cancel event
        execute player command "lostskyworth:lssell"
